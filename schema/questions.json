{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "onesie question file",
  "$comment": "Generated by onesie. Each top level key is a question id, apart from assert, abstain_if and $schema. A file is checked as if it runs on its own, except that its gate and its fallbacks may come from flags.",
  "type": "object",
  "if": {
    "required": [
      "questions"
    ]
  },
  "then": {
    "$ref": "#/definitions/body"
  },
  "else": {
    "propertyNames": {
      "not": {
        "anyOf": [
          {
            "enum": [
              "answer",
              "abstain",
              "answers",
              "error",
              "id",
              "model",
              "usage",
              "questions",
              "state"
            ]
          },
          {
            "pattern": "^__",
            "patternErrorMessage": "An id that starts with two underscores is reserved."
          }
        ]
      },
      "errorMessage": "This question id is reserved."
    },
    "properties": {
      "assert": {
        "description": "A gate over every answer, as --assert takes it.",
        "type": [
          "string",
          "boolean"
        ]
      },
      "abstain_if": {
        "description": "An abstain expression, as --abstain-if takes it.",
        "type": [
          "string",
          "boolean"
        ]
      },
      "$schema": {
        "description": "The schema an editor checks this file against. onesie ignores it.",
        "type": "string"
      }
    },
    "additionalProperties": {
      "$ref": "#/definitions/question"
    }
  },
  "definitions": {
    "body": {
      "description": "A request body, sent to the API as written.",
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "state": {
          "description": "What the model judges, as text or any JSON value."
        },
        "model": {
          "description": "The model to ask, unless -m names one.",
          "type": "string"
        },
        "questions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/wire_question"
          }
        },
        "long_context": {
          "description": "Raises the context limits of the request. Only true has an effect.",
          "type": "boolean"
        },
        "assets": {
          "description": "The images the state and questions name, by reference.",
          "type": "object"
        },
        "$schema": {
          "description": "The schema an editor checks this file against. onesie ignores it.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "wire_question": {
      "description": "A question as the API reads it.",
      "type": "object",
      "required": [
        "type",
        "instructions"
      ],
      "properties": {
        "type": {
          "enum": [
            "noul",
            "choice",
            "score",
            "box"
          ]
        },
        "instructions": {
          "description": "The question, as text or any JSON value."
        },
        "criteria": {
          "description": "The rubric, options or levels the type takes. A box takes none."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "noul"
              }
            }
          },
          "then": {
            "properties": {
              "criteria": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "true": {
                    "description": "What a yes means."
                  },
                  "false": {
                    "description": "What a no means."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "criteria"
            ],
            "properties": {
              "criteria": {
                "description": "Each option name, mapped to its description or null.",
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "score"
              }
            }
          },
          "then": {
            "required": [
              "criteria"
            ],
            "properties": {
              "criteria": {
                "description": "The levels from lowest to highest.",
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "box"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "criteria"
              ]
            },
            "errorMessage": "A box question takes no criteria."
          }
        }
      ]
    },
    "question": {
      "description": "A question, as its instructions alone or as a mapping of its fields.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "patternErrorMessage": "A question needs text, not only spaces."
        },
        {
          "$ref": "#/definitions/fields"
        }
      ]
    },
    "fields": {
      "type": "object",
      "required": [
        "ask"
      ],
      "properties": {
        "ask": {
          "description": "The instructions sent to the API, as text or a mapping or sequence of it.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S",
              "patternErrorMessage": "A question needs text, not only spaces."
            },
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "array",
              "minItems": 1
            }
          ],
          "errorMessage": "A question needs text the model can answer, not a blank, a number or null."
        },
        "yes_means": {
          "description": "What a yes means."
        },
        "no_means": {
          "description": "What a no means."
        },
        "true": {
          "description": "Another spelling of yes_means."
        },
        "false": {
          "description": "Another spelling of no_means."
        },
        "pick": {
          "description": "The options, as a sequence of names or a mapping of name to description.",
          "allOf": [
            {
              "$ref": "#/definitions/pick"
            }
          ]
        },
        "rate": {
          "description": "The levels from lowest to highest, as names, one key mappings of name to description, or a mapping of name to description.",
          "allOf": [
            {
              "$ref": "#/definitions/rate"
            }
          ]
        },
        "box": {
          "description": "Makes this a box question, answered with the edges of what it finds in an image.",
          "const": true
        },
        "threshold": {
          "description": "The yes probability a yes or no answer must reach, between 0 and 1.",
          "allOf": [
            {
              "$ref": "#/definitions/probability"
            }
          ]
        },
        "min_confidence": {
          "description": "The confidence a pick or rate answer must reach, between 0 and 1, or the fallback stands in.",
          "allOf": [
            {
              "$ref": "#/definitions/probability"
            }
          ]
        },
        "fallback": {
          "description": "The answer that stands in for one that falls short.",
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "pick",
                  "rate"
                ]
              },
              {
                "required": [
                  "pick",
                  "box"
                ]
              },
              {
                "required": [
                  "rate",
                  "box"
                ]
              }
            ]
          },
          "errorMessage": "A question has one of pick, rate or box."
        },
        {
          "not": {
            "required": [
              "yes_means",
              "true"
            ]
          },
          "errorMessage": "yes_means and true name the same description. Keep one."
        },
        {
          "not": {
            "required": [
              "no_means",
              "false"
            ]
          },
          "errorMessage": "no_means and false name the same description. Keep one."
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "pick"
                ]
              },
              {
                "required": [
                  "rate"
                ]
              },
              {
                "required": [
                  "box"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "yes_means"
                  ]
                },
                {
                  "required": [
                    "no_means"
                  ]
                },
                {
                  "required": [
                    "true"
                  ]
                },
                {
                  "required": [
                    "false"
                  ]
                },
                {
                  "required": [
                    "threshold"
                  ]
                }
              ]
            },
            "errorMessage": "A pick, rate or box question takes no yes_means, no_means, true, false or threshold."
          },
          "else": {
            "properties": {
              "fallback": {
                "description": "A yes or no question falls back to true, false, yes or no.",
                "examples": [
                  true,
                  false,
                  "yes",
                  "no"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "box"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min_confidence"
                  ]
                },
                {
                  "required": [
                    "fallback"
                  ]
                }
              ]
            },
            "errorMessage": "A box question takes no min_confidence or fallback."
          }
        }
      ]
    },
    "pick": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 255
        },
        {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 255
        }
      ]
    },
    "rate": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1
              }
            ]
          },
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 10
        },
        {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 10
        }
      ]
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
