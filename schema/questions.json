{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "onesie question file",
  "$comment": "Generated by onesie. Each top level key is a question id, apart from assert, abstain_if and $schema.",
  "type": "object",
  "if": {
    "required": [
      "questions"
    ]
  },
  "then": true,
  "else": {
    "propertyNames": {
      "not": {
        "anyOf": [
          {
            "enum": [
              "answer",
              "abstain",
              "answers",
              "error",
              "id",
              "model",
              "usage",
              "questions",
              "state"
            ]
          },
          {
            "pattern": "^__"
          }
        ]
      }
    },
    "properties": {
      "assert": {
        "description": "A gate over every answer, as --assert takes it.",
        "type": "string"
      },
      "abstain_if": {
        "description": "An abstain expression, as --abstain-if takes it.",
        "type": "string"
      },
      "$schema": {
        "description": "The schema an editor checks this file against. onesie ignores it.",
        "type": "string"
      }
    },
    "additionalProperties": {
      "$ref": "#/definitions/question"
    },
    "dependencies": {
      "abstain_if": [
        "assert"
      ]
    },
    "not": {
      "propertyNames": {
        "enum": [
          "assert",
          "abstain_if",
          "$schema"
        ]
      }
    }
  },
  "definitions": {
    "question": {
      "description": "A question, as its instructions alone or as a mapping of its fields.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/fields"
        }
      ]
    },
    "fields": {
      "type": "object",
      "required": [
        "ask"
      ],
      "properties": {
        "ask": {
          "description": "The instructions sent to the API."
        },
        "yes_means": {
          "description": "What a yes means."
        },
        "no_means": {
          "description": "What a no means."
        },
        "true": {
          "description": "Another spelling of yes_means."
        },
        "false": {
          "description": "Another spelling of no_means."
        },
        "pick": {
          "$ref": "#/definitions/pick"
        },
        "rate": {
          "$ref": "#/definitions/rate"
        },
        "threshold": {
          "description": "The yes probability a yes/no answer must reach.",
          "$ref": "#/definitions/probability"
        },
        "min_confidence": {
          "description": "The confidence a pick or rate answer must reach, or the fallback stands in.",
          "$ref": "#/definitions/probability"
        },
        "fallback": {
          "description": "The answer that stands in for one that falls short.",
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "additionalProperties": false,
      "dependencies": {
        "min_confidence": [
          "fallback"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "pick",
              "rate"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "pick"
                ]
              },
              {
                "required": [
                  "rate"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "yes_means"
                  ]
                },
                {
                  "required": [
                    "no_means"
                  ]
                },
                {
                  "required": [
                    "true"
                  ]
                },
                {
                  "required": [
                    "false"
                  ]
                },
                {
                  "required": [
                    "threshold"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "fallback": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "pattern": "^([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|[Yy][Ee][Ss]|[Nn][Oo])$"
                  }
                ]
              }
            },
            "not": {
              "required": [
                "min_confidence"
              ]
            }
          }
        }
      ]
    },
    "pick": {
      "description": "The options, as a sequence of names or a mapping of name to description.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 255
        },
        {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 255
        }
      ]
    },
    "rate": {
      "description": "The levels from lowest to highest, as names, one key mappings of name to description, or a mapping of name to description. Either every level has a description or none does.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "null"
                    },
                    "minProperties": 1,
                    "maxProperties": 1
                  }
                ]
              },
              "uniqueItems": true
            },
            {
              "items": {
                "type": "object",
                "additionalProperties": {
                  "not": {
                    "type": "null"
                  }
                },
                "minProperties": 1,
                "maxProperties": 1
              }
            }
          ]
        },
        {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 10,
          "anyOf": [
            {
              "additionalProperties": {
                "type": "null"
              }
            },
            {
              "additionalProperties": {
                "not": {
                  "type": "null"
                }
              }
            }
          ]
        }
      ]
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
