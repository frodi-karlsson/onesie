{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "onesie question file",
  "$comment": "Generated by onesie. Each top level key is a question id, apart from assert, abstain_if and $schema. The schema accepts any file some command line can use, so a rule a flag can satisfy is left to onesie.",
  "type": "object",
  "if": {
    "required": [
      "questions"
    ]
  },
  "then": true,
  "else": {
    "propertyNames": {
      "not": {
        "anyOf": [
          {
            "enum": [
              "answer",
              "abstain",
              "answers",
              "error",
              "id",
              "model",
              "usage",
              "questions",
              "state"
            ]
          },
          {
            "pattern": "^__",
            "patternErrorMessage": "An id that starts with two underscores is reserved."
          }
        ]
      },
      "errorMessage": "This question id is reserved."
    },
    "properties": {
      "assert": {
        "description": "A gate over every answer, as --assert takes it.",
        "type": "string"
      },
      "abstain_if": {
        "description": "An abstain expression, as --abstain-if takes it.",
        "type": "string"
      },
      "$schema": {
        "description": "The schema an editor checks this file against. onesie ignores it.",
        "type": "string"
      }
    },
    "additionalProperties": {
      "$ref": "#/definitions/question"
    }
  },
  "definitions": {
    "question": {
      "description": "A question, as its instructions alone or as a mapping of its fields.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/fields"
        }
      ]
    },
    "fields": {
      "type": "object",
      "required": [
        "ask"
      ],
      "properties": {
        "ask": {
          "description": "The instructions sent to the API."
        },
        "yes_means": {
          "description": "What a yes means."
        },
        "no_means": {
          "description": "What a no means."
        },
        "true": {
          "description": "Another spelling of yes_means."
        },
        "false": {
          "description": "Another spelling of no_means."
        },
        "pick": {
          "description": "The options, as a sequence of names or a mapping of name to description.",
          "allOf": [
            {
              "$ref": "#/definitions/pick"
            }
          ]
        },
        "rate": {
          "description": "The levels from lowest to highest, as names, one key mappings of name to description, or a mapping of name to description.",
          "allOf": [
            {
              "$ref": "#/definitions/rate"
            }
          ]
        },
        "threshold": {
          "description": "The yes probability a yes/no answer must reach, between 0 and 1.",
          "type": "number"
        },
        "min_confidence": {
          "description": "The confidence a pick or rate answer must reach, between 0 and 1, or the fallback stands in.",
          "type": "number"
        },
        "fallback": {
          "description": "The answer that stands in for one that falls short.",
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "pick",
              "rate"
            ]
          },
          "errorMessage": "A question has pick or rate, not both."
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "pick"
                ]
              },
              {
                "required": [
                  "rate"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "yes_means"
                  ]
                },
                {
                  "required": [
                    "no_means"
                  ]
                },
                {
                  "required": [
                    "true"
                  ]
                },
                {
                  "required": [
                    "false"
                  ]
                },
                {
                  "required": [
                    "threshold"
                  ]
                }
              ]
            },
            "errorMessage": "A pick or rate question takes no yes_means, no_means, true, false or threshold."
          },
          "else": {
            "properties": {
              "fallback": {
                "description": "A yes/no question falls back to true, false, yes or no.",
                "examples": [
                  true,
                  false,
                  "yes",
                  "no"
                ]
              }
            }
          }
        }
      ]
    },
    "pick": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 255
        },
        {
          "type": "object",
          "maxProperties": 255
        }
      ]
    },
    "rate": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1
              }
            ]
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        {
          "type": "object",
          "maxProperties": 10
        }
      ]
    }
  }
}
